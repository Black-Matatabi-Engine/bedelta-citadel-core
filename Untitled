#!/bin/bash

# 定義顏色
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 解析 -d 或 --deploy 參數
DEPLOY_FLAG=false
for arg in "$@"; do
  if [ "$arg" == "-d" ] || [ "$arg" == "--deploy" ]; then
    DEPLOY_FLAG=true
  fi
done

# 自動清除可能殘留的 rebase 鎖定
git rebase --abort 2>/dev/null || true

echo -e "${BLUE}[1/6] 📜 Running Yellow Page Audit Log...${NC}"
npm run audit:log

echo -e "${BLUE}[2/6] 📦 Staging all workspace changes...${NC}"
git add .

echo -e "${BLUE}[3/6] ✍️ Committing with SilverVine Signature...${NC}"
git commit -m 'chore(audit): daily EOD yellow page audit log sync' --author=':qum[x0sumx] | SilverVine <github@silvervinelabs.com>' || true

echo -e "${BLUE}[4/6] 🔄 Auto-Merging (Allowing Unrelated Histories)...${NC}"
git pull origin main --allow-unrelated-histories --no-rebase -X ours --no-edit || true

echo -e "${BLUE}[5/6] 🚀 Syncing & Pushing to Remote Repository...${NC}"
git push origin main

# 如果帶有 -d 參數，則執行部署指令
if [ "$DEPLOY_FLAG" = true ]; then
  echo -e "${YELLOW}[5.5/6] ⚡ Deploy Flag Detected! Triggering Production Deployment...${NC}"
  npm run deploy || npx wrangler deploy || echo "Deploy script executed."
fi

echo -e "${GREEN}[6/6] ✅ EOD Wrap Completed! Telemetry & Deploy Pipeline Active.${NC}"