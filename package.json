{
  "name": "bedelta-living-water",
  "version": "1.0.0",
  "description": "BeDelta Living Water — Hyperliquid-native yield ingress & session-key risk envelope",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:worker",
    "build:spa": "vite build",
    "build:worker": "pnpm run build:spa && pnpm exec tsc --noEmit && WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --outdir=dist-worker",
    "test": "vitest run --coverage",
    "grant:verify": "vitest run tests/integration/hl-2pc-execution.test.ts tests/e2e/grant-sandbox-dryrun.test.ts",
    "grant:hl-testnet": "tsx scripts/verify-hl-testnet.ts",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm run build:spa && wrangler dev",
    "dev:spa": "vite",
    "test:watch": "vitest",
    "deploy": "pnpm run build:spa && wrangler deploy",
    "cf-typegen": "wrangler types",
    "audit:log": "node scripts/generate-yellow-page.js"
  },
  "keywords": [],
  "author": "SilverVine Labs",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250719.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.113.0"
  },
  "volta": {
    "node": "20.20.2"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/hashes": "1.8.0",
    "ethers": "^6.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
