{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bedelta-living-water",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "kv_namespaces": [
    {
      "binding": "BEDELTA_WATER_KV",
      "id": "60db4bcba35248dba594ef109e4065b1",
      "remote": true
    },
    {
      "binding": "SLIVERVINE_KV",
      "id": "60db4bcba35248dba594ef109e4065b1",
      "remote": true
    },
    {
      "binding": "SYSTEM_STATE_KV",
      "id": "60db4bcba35248dba594ef109e4065b1",
      "remote": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "NEXT_PUBLIC_HUD_CANARY": "bedelta-stealth"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "bedeltawater.slivervine.xyz",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/1 * * * *"]
  }
}
